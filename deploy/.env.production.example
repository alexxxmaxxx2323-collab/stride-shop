# Прод-конфиг для VPS. Скопируй в backend/.env и заполни значения.
# backend/.env в .gitignore — секреты не попадут в репозиторий.

APP_ENV=prod
APP_HOST=127.0.0.1
APP_PORT=8077
DATABASE_URL=sqlite:///./shop.db

# ВАЖНО: на проде задай длинный случайный секрет, напр.:  openssl rand -hex 32
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_HEX_32_БАЙТА
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=10080

# Боевой адрес сайта (с https). Из него собираются ссылки в письмах,
# webhook бота и URL мини-аппы. БЕЗ него письма уйдут с http://127.0.0.1.
PUBLIC_URL=https://stride-shop.ru

# Телеграм-бот: webhook поднимется автоматически при старте (есть токен + PUBLIC_URL).
TG_BOT_TOKEN=ТОКЕН_БОТА_ОТ_BOTFATHER
ADMIN_TG_ID=7984490674
# Секрет в пути webhook — поменяй на свой случайный (openssl rand -hex 16).
TG_WEBHOOK_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ

# Почта (Яндекс, SSL/465). Пароль приложения — НЕ пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SSL=true
SMTP_TLS=false
SMTP_USER=roman.neverland@yandex.ru
SMTP_PASSWORD=ПАРОЛЬ_ПРИЛОЖЕНИЯ
SMTP_FROM=Stride Shop <roman.neverland@yandex.ru>

# ЮKassa — для портфолио держим тестовый режим (заполнить позже).
# Пусто — оплата работает в режиме mock-заглушки. Заполнено — реальный
# виджет ЮKassa (карта/СБП/кошельки). Креды из ЛК yookassa.ru (тестовый магазин).
# В настройках магазина ЮKassa указать URL для уведомления payment.succeeded:
#   https://<домен>/payments/yookassa/webhook
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
