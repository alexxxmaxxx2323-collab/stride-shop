APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./shop.db

# Секрет для подписи JWT (на проде — длинная случайная строка)
JWT_SECRET=dev-only-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=10080

# Токен телеграм-бота (для проверки подписи initData из mini-app)
TG_BOT_TOKEN=

# Почта (SMTP). Пусто — письма не уходят, печатаются в консоль ([email:STUB]).
# Яндекс/Mail.ru: SSL на 465 (SMTP_SSL=true, SMTP_TLS=false).
# Gmail/Brevo: STARTTLS на 587 (SMTP_SSL=false, SMTP_TLS=true).
# SMTP_PASSWORD — пароль приложения, не пароль аккаунта. SMTP_FROM = адрес из SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=false
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Stride Shop <no-reply@stride.shop>
